$ORIGIN app1.example.net.
@   IN  SOA  ns1.app1.example.net. admin.app1.example.net. (
            2024010101  ; serial
            3600        ; refresh
            900         ; retry
            604800      ; expire
            86400 )     ; minimum

@       IN  NS  ns1.app1.example.net.
@       IN  NS  ns2.app1.example.net.
ns1     IN  A   10.0.0.1
ns2     IN  A   10.0.0.2
@       IN  A   10.0.0.10
