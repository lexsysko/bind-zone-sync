    type primary;
    allow-query { any; };
    file "/usr/local/etc/namedb/primary/app1.example.net.db";
};

zone "app2.example.net" {
    type primary;
    allow-query { any; };
    file "/usr/local/etc/namedb/primary/app2.example.net.db";
};

